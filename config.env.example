# Copia este archivo a config.env (o ejecuta `sudo bash bootstrap.sh --wizard`).
# Este archivo es cargado como shell por root: mantén permisos 600 y valores de confianza.

SERVER_HOSTNAME="debian-server"
TIMEZONE="UTC"

# Usuario administrativo no-root y modo de sudo:
# - "password": pide contraseña al usar sudo (se solicitará interactivamente en 01-system.sh
#               o mediante ADMIN_PASSWORD_HASH en ejecuciones desatendidas).
# - "nopasswd": crea regla NOPASSWD validada con visudo en /etc/sudoers.d/90-server-bootstrap.
ADMIN_USER="adminops"
SUDO_MODE="password"

# Opcional para modo no interactivo con SUDO_MODE="password":
# genera el hash con: openssl passwd -6
ADMIN_PASSWORD_HASH=""

# Una o más llaves públicas OpenSSH (ssh-ed25519, ssh-rsa, ecdsa-sha2-*, sk-*).
# Nunca coloques llaves privadas aquí.
SSH_PUBLIC_KEYS=(
  "ssh-ed25519 AAAA_REEMPLAZAR usuario@equipo"
)

# Puerto SSH deseado (si difiere del actual, 02-security.sh realiza transición segura en dos pasos).
SSH_PORT="22"

# Firewall UFW (yes / no) y puertos adicionales separados por espacio (ej. "80/tcp 443/tcp").
ENABLE_UFW="yes"
EXTRA_UFW_PORTS=""

# Fail2Ban para SSH (yes / no) y lista blanca opcional de IPs/redes separadas por espacio.
ENABLE_FAIL2BAN="yes"
FAIL2BAN_IGNOREIP=""

# Actualizaciones automáticas de seguridad (yes / no) y reinicio programado opcional.
ENABLE_UNATTENDED_UPGRADES="yes"
AUTO_REBOOT="no"
AUTO_REBOOT_TIME="04:00"

# Prompt Bash moderno en colores (root y ADMIN_USER) y MOTD con banner ASCII Art.
ENABLE_PROMPT="yes"
ENABLE_MOTD="yes"
# Texto para el ASCII Art del MOTD (vacío = usa SERVER_HOSTNAME; máx. 40 caracteres A-Z 0-9 . _ ! -).
MOTD_TEXT=""
# Colores disponibles: lime | green | cyan | magenta | pink | orange | yellow | purple | blue | red | toxic | synthwave | rainbow
MOTD_COLOR="lime"
# Estilo del ASCII Art: block (bloques Unicode ██) | ascii (caracteres ##)
MOTD_ART_STYLE="block"

# Seguridad: por defecto en NO. El asistente interactivo lo cambia a YES tras confirmar acceso SSH,
# o cámbialo manualmente a "YES" después de verificar login con llave y sudo.
CONFIRM_SSH_HARDENING="NO"
