# Copy this file to config.env (or run `sudo bash bootstrap.sh --wizard`).
# This file is sourced as a shell script by root: keep 600 permissions and trusted values.

SERVER_HOSTNAME="debian-server"
# Server public IP to register in /etc/hosts alongside the hostname (empty = auto-detect).
SERVER_IP=""
TIMEZONE="UTC"

# Non-root administrative user and sudo mode:
# - "password": prompts for password when using sudo (requested interactively in 01-system.sh
#               or via ADMIN_PASSWORD_HASH in unattended runs).
# - "nopasswd": creates a NOPASSWD rule validated with visudo in /etc/sudoers.d/90-server-bootstrap.
ADMIN_USER="adminops"
SUDO_MODE="password"

# Optional for non-interactive mode with SUDO_MODE="password":
# generate the hash with: openssl passwd -6
ADMIN_PASSWORD_HASH=""

# One or more OpenSSH public keys (ssh-ed25519, ssh-rsa, ecdsa-sha2-*, sk-*).
# Never place private keys here.
SSH_PUBLIC_KEYS=(
  "ssh-ed25519 AAAA_REPLACE user@host"
)

# Desired SSH port (if different from current, 02-security.sh performs a safe two-step transition).
SSH_PORT="22"

# UFW Firewall (yes / no) and additional space-separated ports (e.g. "80/tcp 443/tcp").
ENABLE_UFW="yes"
EXTRA_UFW_PORTS=""

# Fail2Ban for SSH (yes / no) and optional space-separated whitelist of IPs/networks.
ENABLE_FAIL2BAN="yes"
FAIL2BAN_IGNOREIP=""

# Automatic security updates (yes / no) and optional scheduled reboot.
ENABLE_UNATTENDED_UPGRADES="yes"
AUTO_REBOOT="no"
AUTO_REBOOT_TIME="04:00"

# MOTD with ASCII Art banner (the .bashrc and prompt for root and ADMIN_USER are always configured).
ENABLE_MOTD="yes"
# Text for the MOTD ASCII Art (empty = uses SERVER_HOSTNAME; max 40 chars A-Z 0-9 . _ ! -).
MOTD_TEXT=""
# Available colors: lime | green | cyan | magenta | pink | orange | yellow | purple | blue | red | toxic | synthwave | rainbow
MOTD_COLOR="lime"
# Selectable ASCII Art design by name: claude | hermes | shadow | block | ascii
MOTD_ART_STYLE="claude"

# Safety: defaults to NO. The interactive wizard sets it to YES after confirming SSH access,
# or change it manually to "YES" after verifying key-based login and sudo.
CONFIRM_SSH_HARDENING="NO"
