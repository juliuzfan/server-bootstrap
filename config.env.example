# Copia este archivo a config.env y edita los valores.
# Este archivo es cargado como shell: solo usa valores de confianza.

HOSTNAME="debian-server"
TIMEZONE="America/Mexico_City"

# Usuario administrativo no-root
ADMIN_USER="adminops"

# Pega la llave PUBLICA completa (normalmente comienza con ssh-ed25519).
# No pegues nunca tu llave privada.
SSH_PUBLIC_KEY="ssh-ed25519 AAAA_REEMPLAZAR usuario@equipo"

# Puerto SSH actual y deseado. Para una instalación limpia normalmente 22.
SSH_PORT="22"

# Valores admitidos: yes / no
ENABLE_UFW="yes"
ENABLE_FAIL2BAN="yes"
ENABLE_UNATTENDED_UPGRADES="yes"

# Debe ser YES para aplicar cambios SSH que deshabilitan password/root.
# El orquestador además pedirá confirmación interactiva después de probar la llave.
CONFIRM_SSH_HARDENING="YES"
